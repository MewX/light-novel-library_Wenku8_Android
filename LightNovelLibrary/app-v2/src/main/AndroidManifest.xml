<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <queries>
        <!-- Required on Android 11+ (API 30+) to discover and bind system / open-source TTS engines -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Allow checking and launching voice-data downloads for installed TTS engines -->
        <intent>
            <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
        <!-- Forward-compatible discovery for official or community enhanced Wenku8 TTS plugins -->
        <intent>
            <action android:name="org.mewx.wenku8.action.TTS_PLUGIN_V1" />
        </intent>
    </queries>

    <application
        android:name=".Wenku8V2Application"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wenku8V2"
        android:usesCleartextTraffic="true">

        <!-- Required by Google UMP SDK for consent form resolution (Next-Gen GMA SDK receives the
             same build-type-strict App ID programmatically via InitializationConfig). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- Verified Android App Links for https://share.wenku8.app/book/<aid>.
                 Requires https://share.wenku8.app/.well-known/assetlinks.json (HTTP 200 JSON, no redirects). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="share.wenku8.app" />
                <data android:pathPrefix="/book/" />
            </intent-filter>

            <!-- Custom URI scheme fallback (wenku8://book/<aid>) for browser "Open in App" CTAs
                 and devices/ROMs where App Links domain verification is unavailable. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="wenku8"
                    android:host="book"
                    android:pathPrefix="/" />
            </intent-filter>
        </activity>

        <!-- Preserves Play Store v1.x pinned launcher shortcuts (org.mewx.wenku8.activity.MainActivity)
             on in-place upgrade without creating duplicate app-drawer icons. -->
        <activity-alias
            android:name="org.mewx.wenku8.activity.MainActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_file_provider_paths" />
        </provider>

        <receiver
            android:name=".widget.ContinueReadingAppWidgetProvider"
            android:exported="true"
            android:label="@string/widget_continue_reading_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_reading_widget_info" />
        </receiver>

    </application>

</manifest>
